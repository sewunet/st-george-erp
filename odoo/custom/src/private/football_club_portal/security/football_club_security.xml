<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_football_club" model="ir.module.category">
        <field name="name">Football Club</field>
        <field name="description">Football club fan and event management</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_football_club" model="res.groups.privilege">
        <field name="name">Football Club</field>
        <field name="category_id" ref="football_club_portal.module_category_football_club"/>
    </record>

    <record id="group_football_club_user" model="res.groups">
        <field name="name">Football Club User</field>
        <field name="privilege_id" ref="football_club_portal.res_groups_privilege_football_club"/>
    </record>

    <record id="group_football_club_manager" model="res.groups">
        <field name="name">Football Club Manager</field>
        <field name="privilege_id" ref="football_club_portal.res_groups_privilege_football_club"/>
        <field name="implied_ids" eval="[(4, ref('football_club_portal.group_football_club_user'))]"/>
    </record>

    <record id="rule_football_club_fan_user" model="ir.rule">
        <field name="name">Football Club fan records for users</field>
        <field name="model_id" ref="model_football_club_fan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('football_club_portal.group_football_club_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_football_club_event_user" model="ir.rule">
        <field name="name">Football Club event records for users</field>
        <field name="model_id" ref="model_football_club_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('football_club_portal.group_football_club_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
