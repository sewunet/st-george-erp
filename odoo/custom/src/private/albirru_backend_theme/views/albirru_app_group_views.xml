<?xml version="1.0" encoding="utf-8"?>
<!-- Albirru Backend Theme - App Group Views -->
<!-- Compatible with Odoo 19 -->
<odoo>
    <data>
        <!-- List View for App Group -->
        <record id="view_albirru_app_group_list" model="ir.ui.view">
            <field name="name">albirru.app.group.list</field>
            <field name="model">albirru.app.group</field>
            <field name="arch" type="xml">
                <list string="App Groups" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="group_menu_icon" widget="image" 
                           options="{'preview_image': 'group_menu_icon'}" 
                           class="o_field_image o_image_64_max"/>
                    <field name="group_menu_list_ids" widget="many2many_tags"/>
                    <field name="use_group_icon"/>
                    <field name="group_icon_class_name" 
                           invisible="not use_group_icon" 
                           placeholder="e.g., fa-folder"/>
                    <field name="company_id" groups="base.group_multi_company" optional="show"/>
                    <field name="active" invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Form View for App Group -->
        <record id="view_albirru_app_group_form" model="ir.ui.view">
            <field name="name">albirru.app.group.form</field>
            <field name="model">albirru.app.group</field>
            <field name="arch" type="xml">
                <form string="App Group">
                    <sheet>
                        <div class="oe_button_box" name="button_box"/>
                        <field name="group_menu_icon" widget="image" 
                               class="oe_avatar" 
                               options="{'preview_image': 'group_menu_icon'}"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Group Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="sequence"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="use_group_icon"/>
                                <field name="group_icon_class_name" 
                                       invisible="not use_group_icon"
                                       placeholder="fa-folder"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Applications" name="applications">
                                <field name="group_menu_list_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="web_icon" invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action to Open App Group Views -->
        <record id="action_albirru_app_group" model="ir.actions.act_window">
            <field name="name">App Groups</field>
            <field name="res_model">albirru.app.group</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_albirru_app_group_list"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first App Group
                </p>
                <p>
                    App Groups help organize applications in the App Drawer.
                    Create groups like "Sales", "Inventory", "Accounting" to
                    categorize your applications.
                </p>
            </field>
        </record>
    </data>
</odoo>
